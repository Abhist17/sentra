# ── Network ──────────────────────────────────────────────────────
# Cluster the risk snapshots are WRITTEN to.
# Local dev: http://127.0.0.1:8899   Deployed: https://api.devnet.solana.com
RPC_URL=http://127.0.0.1:8899

# Cluster real wallet balances are READ from. The public endpoint is
# heavily rate-limited — use Helius/QuickNode for anything real.
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# ── Server ───────────────────────────────────────────────────────
# Injected automatically by Render/Railway/Fly — only set locally.
PORT=4000

# Allowed browser origins: "*" or a comma-separated list.
# In production set this to your Vercel URL.
CORS_ORIGIN=*

# Protects /wallet/add, /wallet/remove, /test/*. Leave blank for local dev;
# ALWAYS set it in production or anyone can spam your Telegram bot.
API_KEY=

# Requests per minute per IP before the API returns 429
RATE_LIMIT_PER_MIN=120

# Chrome blocks a page on a public origin from calling a loopback address
# unless the server sends Access-Control-Allow-Private-Network. This opt-in is
# what lets the hosted dashboard talk to an engine running on your machine.
# Combined with CORS_ORIGIN=*, it also means any site you visit could reach
# this engine — set CORS_ORIGIN to your dashboard's origin, or turn this off
# if the engine is deployed publicly.
ALLOW_PRIVATE_NETWORK=true

# Where the wallet registry and price-history cache are written.
# Defaults to ./.data — point at a mounted volume on ephemeral hosts.
DATA_DIR=

# ── Signing keypair ──────────────────────────────────────────────
# Preferred in deployment: the secret key inline, base58 or JSON byte array.
SOLANA_SECRET_KEY=

# Alternative: path to a Solana CLI keypair file.
# Falls back to ~/.config/solana/id.json when both are blank.
SOLANA_KEYPAIR_PATH=

# ── Engine tuning (milliseconds unless noted) ────────────────────
# Floor of 10000 — CoinGecko's free tier rate-limits below that.
MONITOR_INTERVAL=30000
HISTORY_REFRESH_INTERVAL=3600000
ALERT_COOLDOWN=300000

# Days of price history behind the covariance matrix (2-365)
HISTORY_DAYS=30

# Risk points kept in memory per wallet — this is what the dashboard charts
HISTORY_POINTS=240

# Ceiling on monitored wallets; each one costs an RPC call per tick
MAX_WALLETS=25

# Percent drop in one interval that counts as a market shock
SHOCK_THRESHOLD=5

# Hybrid risk score (0-100) that triggers a wallet alert
RISK_ALERT_THRESHOLD=25

# Substitute a synthetic portfolio when a monitored wallet is empty.
# Demo only — keep false for real numbers.
SIMULATION_MODE=false

# Write risk scores to the Solana program. Each write rents a new snapshot
# account, so this costs SOL on every interval. Off by default.
ENABLE_ONCHAIN_WRITES=false

# ── Alerts ───────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Price feed ───────────────────────────────────────────────────
# Optional CoinGecko demo key — free tier rate-limits at 30s polling.
COINGECKO_API_KEY=
