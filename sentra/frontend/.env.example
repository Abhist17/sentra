# Base URL of the Sentra engine (backend).
# Local dev: http://localhost:4000   Deployed: https://your-engine.onrender.com
#
# This is baked into the static bundle at build time. Viewers can still point
# their own browser elsewhere with the in-app "Connect to an engine" dialog.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Only needed when the engine has API_KEY set. Note this ships to the browser —
# use it for a personal deployment, not a public one.
NEXT_PUBLIC_API_KEY=

# Set by the GitHub Pages workflow so assets resolve under /<repo>.
# Leave blank for host-root deployments.
NEXT_PUBLIC_BASE_PATH=
