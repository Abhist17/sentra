{
  "license": "ISC",
  "scripts": {
    "lint": "prettier \"programs/**/*.ts\" \"tests/**/*.ts\" --check",
    "lint:fix": "prettier \"programs/**/*.ts\" \"tests/**/*.ts\" -w",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "gen:idl": "node scripts/gen-idl.js",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm --prefix backend test && npm --prefix frontend test"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "name": "sentra",
  "private": true
}
